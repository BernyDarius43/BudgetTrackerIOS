{
  "cli": {
    "version": ">= 16.1.0",
    "appVersionSource": "remote",
    "requireCommit": false
  },
  "build": {
    "base": {
      "node": "22.14.0",
      "env": {
        "API_URL": "/api/v1"
      },
      "ios": {
        "image": "latest",
        "env": {
          "PLATFORM": "ios"
        }
      }
    },
    "development": {
      "channel": "development",
      "developmentClient": true,
      "distribution": "internal",
      "extends": "base",
      "env": {
        "API_URL": "/api/v1",
        "EXPO_PUBLIC_API_BASE_URL": "https://budgettrackerapi-muxo.onrender.com"
      }
    },
    "preview": {
      "channel": "preview",
      "extends": "base",
      "distribution": "internal",
      "env": {
        "API_URL": "/api/v1",
        "EXPO_PUBLIC_API_BASE_URL": "https://budgettrackerapi-muxo.onrender.com"
      }
    },
    "production": {
      "channel": "production",
      "autoIncrement": true,
      "extends": "base",
      "node": "22.14.0",
      "env": {
        "API_URL": "/api/v1",
        "EXPO_PUBLIC_API_BASE_URL": "https://budgettrackerapi-1-utry.onrender.com"
      }
    },
    "ios": {
      "resourceClass": "medium"
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "environment": "development"
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6744070659"
      }
    },
    "development": {
      "ios": {
        "ascAppId": "6744070659"
      }
    },
    "preview": {
      "ios": {
        "ascAppId": "6744070659"
      }
    }
  }
}